# Copy this file to .env and fill in your keys. Never commit .env.
OPENROUTER_API_KEY=

# Optional: Langfuse tracing (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional overrides
# CHAT_MODEL=mistralai/mistral-small-2603
# EMBED_MODEL=mistralai/mistral-embed-2312
# JUDGE_MODEL=<another model on OpenRouter>   # faithfulness judge; defaults to CHAT_MODEL
